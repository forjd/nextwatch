# Copy to .env and fill in. .env is gitignored.
DATABASE_URL=postgresql://nextwatch:nextwatch@127.0.0.1:5433/nextwatch
TEST_DATABASE_URL=postgresql://nextwatch:nextwatch@127.0.0.1:5433/nextwatch_test

# TMDB API Read Access Token (v4 auth), from https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# Ingest tuning (see docs/plans/01-ingest.md)
MIN_VOTES=10
MIN_VOTES_TV=10
TMDB_RPS=20
TMDB_WORKERS=16

# Vibe tags through OpenRouter (see docs/plans/05-vibe-tags.md)
OPENROUTER_API_KEY=
VIBE_MODEL=meta/muse-spark-1.3-contributor
VIBE_CONCURRENCY=8
VIBE_BUDGET_USD=30
